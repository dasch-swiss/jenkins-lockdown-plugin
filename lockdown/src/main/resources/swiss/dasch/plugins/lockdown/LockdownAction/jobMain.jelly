<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:t="/lib/hudson" xmlns:l="/lib/layout">
  <j:if test="${it.lockdownState.lockedDown}">
    <div class="jenkins-alert jenkins-alert-warning">
      <a href="${it.urlName}">
        <l:icon src="symbol-lock-closed" class="icon-lg"/>
        <span class="jenkins-icon-adjacent">
          ${%Status.CurrentlyLockedDown}
        </span>
      </a>
    </div>
  </j:if>
</j:jelly>